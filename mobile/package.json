{
  "name": "ruodian-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --localhost",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
